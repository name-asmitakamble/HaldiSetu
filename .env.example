# Copy to .env and edit. NEVER commit .env
SECRET_KEY=change-me-to-a-long-random-string
# MySQL (production / final demo):
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost/haldisetu?charset=utf8mb4
# SQLite (quick start, no MySQL needed):
# DATABASE_URL=sqlite:///haldisetu.db
CONFIDENCE_THRESHOLD=0.70
MODEL_VERSION=mobilenetv2-v1
# data.gov.in free API key (register at data.gov.in -> My Account). Used by mandi_sync.py / Admin 'Sync now'
DATA_GOV_API_KEY=
# Admin account created by seed.py
ADMIN_PHONE=9000000000
ADMIN_PASSWORD=change-this-admin-password

# OPTIONAL — Marathi/Hindi text understanding, proof-document reading, negotiation drafts.
# Leave empty and the app still works fully (rule-based fallbacks). Needs:  pip install anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
